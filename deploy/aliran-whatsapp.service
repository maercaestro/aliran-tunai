[Unit]
Description=AliranTunai WhatsApp Business API Service
After=network.target mongod.service
Wants=network.target

[Service]
Type=simple
User=abuhuzaifahbidin
Group=abuhuzaifahbidin
WorkingDirectory=/opt/aliran-tunai/current
Environment=PATH=/opt/aliran-tunai/current/venv/bin
Environment=FLASK_ENV=production

# Environment variables
EnvironmentFile=/opt/aliran-tunai/current/.env

# Run under gunicorn. We keep workers low (2) because the in-process
# pending_* dicts are not yet shared via Redis -- each extra worker
# would split user state. Threads handle concurrency for the I/O-bound
# OpenAI / WhatsApp / Mongo calls.
ExecStart=/opt/aliran-tunai/current/venv/bin/gunicorn \
    --workers 2 --threads 16 --timeout 90 \
    --bind 127.0.0.1:5002 \
    --access-logfile - --error-logfile - \
    whatsapp_business_api:app
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aliran-whatsapp

# Security
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/aliran-tunai/current
ReadWritePaths=/var/log/aliran-tunai
ReadWritePaths=/tmp

# Resource limits
LimitNOFILE=65536
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target